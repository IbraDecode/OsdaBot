# ============================================================
# OSDA Platform — contoh konfigurasi environment
# Salin ke .env lalu isi dengan nilai asli.
#   cp .env.example .env
# JANGAN pernah commit berkas .env yang sudah terisi.
# ============================================================

# ---- Aplikasi -----------------------------------------------
NODE_ENV=development
# Zona waktu sekolah, dipakai untuk scheduler absensi & laporan harian
TZ=Asia/Makassar

# ---- API ----------------------------------------------------
API_PORT=4000
# URL publik API, dipakai untuk membuat tautan dalam (deep link) ke Web/Mobile
PUBLIC_API_URL=http://localhost:4000
# Asal yang diizinkan untuk CORS (pisahkan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Jumlah request per menit per IP
RATE_LIMIT_PER_MINUTE=120

# ---- Database ----------------------------------------------
# PostgreSQL. Untuk pengembangan lokal bisa dipakai PGlite (tanpa Docker):
#   PGLITE_DIR=./.pgdata  → dipakai otomatis bila DATABASE_URL kosong
DATABASE_URL=
# Ukuran connection pool
DATABASE_POOL_MAX=10
# Unit harga untuk laporan keuangan (tanpa titik pemisah)
FINANCE_CURRENCY=IDR

# ---- Redis (opsional) --------------------------------------
# Bila kosong, API tetap jalan; antrean memakai fallback in-process.
REDIS_URL=

# ---- Autentikasi -------------------------------------------
# WAJIB diganti di produksi. Generate: openssl rand -base64 48
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-rahasia-acak-lain-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Umur cookie refresh (hari)
REFRESH_COOKIE_DAYS=30

# ---- Penyimpanan objek (S3-compatible) ---------------------
# Bucket WAJIB private. Jangan pernah mengekspos bucket publik.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=osda-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ---- WhatsApp ----------------------------------------------
WHATSAPP_ENABLED=false
# Nomor bot, format 62xxx (tanpa +)
WHATSAPP_PHONE_NUMBER=
# Direktori penyimpanan kredensial Baileys
WHATSAPP_SESSION_DIR=./whatsapp-session
# Prefix tautan dalam yang dikirim ke anggota
PUBLIC_WEB_URL=http://localhost:3000

# ---- Email (opsional) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OSDA <no-reply@osda.local>

# ---- Pembayaran (opsional, mis. BaturPay / QRIS) ----------
PAYMENT_PROVIDER=baturpay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
WEBHOOK_PORT=4001

# ---- Seed akun awal ----------------------------------------
# Dipakai `pnpm db:seed` untuk membuat administrator pertama.
SEED_SUPER_ADMIN_EMAIL=admin@osis.local
SEED_SUPER_ADMIN_PASSWORD=GantiPassword123!
SEED_ORGANIZATION_NAME=OSIS SMKN 2 Mataram
