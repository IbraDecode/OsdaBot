# =============================================================================
# OSDABOT — Contoh konfigurasi (.env.example)
# =============================================================================
# Salin ke .env lalu isi. JANGAN PERNAH commit .env yang berisi nilai asli.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL) ---------------------------------------------------
# Untuk produksi pakai connection pooler. Untuk `prisma migrate dev` lokal
# kadang perlu URL unpooled agar tidak exhausting koneksi.
DATABASE_URL="postgresql://neondb_owner:CHANGE_ME@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=5"

# --- Redis (BullMQ) ----------------------------------------------------------
# Upstash / Redis ber-TLS. Format: rediss://default:PASSWORD@HOST:PORT
REDIS_URL="rediss://default:CHANGE_ME@host.upstash.io:6379"

# --- AI Provider (OpenAI-compatible) -----------------------------------------
AI_BASE_URL="https://example-gateway.com/v1"
AI_API_KEY="sk-xxxxxxxxxxxxxxxx"
AI_MODEL="ibrax"
AI_TEMPERATURE=0.3
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=60000

# --- WhatsApp / Baileys ------------------------------------------------------
WHATSAPP_SESSION_DIR="./auth_info_baileys"
# Nomor akun BOT yang akan DITAUTKAN ke Baileys (bukan nomor pemilik!).
# Format: digits + kode negara, tanpa '+', '-', spasi, atau kurung.
# Contoh Lombok: 6281234567890
WHATSAPP_LINK_PHONE=""

# Nomor pemilik/admin yang mengendalikan. Tidak pernah dikirim ke WhatsApp —
# hanya untuk penyaringan & audit. Harus BEDA dari nomor bot.
WHATSAPP_ADMIN_PHONE=""
# Nama panggilan bot. Dipakai untuk pemicu di grup.
WHATSAPP_BOT_NAME="Osda"
# Risingon/off untuk mengurangi ban (default true, disarankan tetap true).
WHATSAPP_MARK_ONLINE_ON_CONNECT=false

# --- Zaman & locale ----------------------------------------------------------
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

# --- Batas agent -------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_STEPS=8
AGENT_MAX_CONTEXT_MESSAGES=20

# --- Payment (BaturPay) ------------------------------------------------------
# Kosongkan dulu kalau belum dipakai. Lihat docs/PAYMENTS.md
BATURPAY_API_KEY=""
BATURPAY_BASE_URL="https://baturpay.vercel.app"
# Secret webhook akun BaturPay (dari portal BaturPay, BUKAN server key Midtrans).
BATURPAY_WEBHOOK_SECRET=""

# --- Object storage (S3-compatible, opsional) --------------------------------
# Dipakai untuk artifact/dokumen besar. Kalau kosong, pakai penyimpanan lokal.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET=""

# --- Server HTTP (opsional) --------------------------------------------------
# Endpoint ini hanya dipakai untuk health check + penerimaan webhook BaturPay.
# Kalau production di belakang reverse proxy, set hanya bind lokal.
SERVER_HOST="127.0.0.1"
SERVER_PORT=8080
SERVER_BODY_LIMIT_BYTES=2097152

# --- Rate limit (per aktor) --------------------------------------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_TOOL_CALLS_PER_MINUTE=60