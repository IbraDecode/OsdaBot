# OSDA Platform — contoh konfigurasi environment
# Salin ke .env lalu isi dengan nilai asli.
#   cp .env.example .env
# JANGAN pernah commit berkas .env yang sudah terisi.

# ---- Aplikasi -----------------------------------------------
NODE_ENV=development
TZ=Asia/Makassar

# ---- API ----------------------------------------------------
API_PORT=4000
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
RATE_LIMIT_PER_MINUTE=120

# ---- Database ----------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_yLOFZh9kH3Jc@ep-rough-haze-b340d57k-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=10
FINANCE_CURRENCY=IDR

# ---- Redis (opsional) --------------------------------------
REDIS_URL=

# ---- Autentikasi -------------------------------------------
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-rahasia-acak-lain-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REFRESH_COOKIE_DAYS=30

# ---- Penyimpanan objek (S3-compatible) ---------------------
STORAGE_ENDPOINT=https://br-wispy-resonance-b365inmp.storage.c-4.ap-southeast-1.aws.neon.tech
STORAGE_REGION=auto
STORAGE_BUCKET=osda-documents
STORAGE_ACCESS_KEY_ID=nak_live_f602cc5f4d724079b5f2a9303ebfc90f
STORAGE_SECRET_ACCESS_KEY=nsk_live_1ba8d6d6f95ce3edef81e55a6f8673f8328be46334a2e7e7f2a6e4dfa705a5ce
STORAGE_FORCE_PATH_STYLE=true

# ---- WhatsApp ----------------------------------------------
# Session lama dari bot sebelumnya masih bisa dipakai
WHATSAPP_ENABLED=true
# Nomor bot, format 62xxx (tanpa +)
# Isi dengan nomor bot asli jika ada, atau biarkan sesuai session lama
WHATSAPP_PHONE_NUMBER=628xxxxxx
WHATSAPP_SESSION_DIR=./whatsapp-session
PUBLIC_WEB_URL=http://localhost:3000

# ---- Email (opsional) --------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OSDA <no-reply@osda.local>

# ---- Pembayaran (opsional) ----------
PAYMENT_PROVIDER=baturpay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
WEBHOOK_PORT=4001

# ---- Seed akun awal ----------------------------------------
# Dipakai `pnpm db:seed` untuk membuat administrator pertama.
# WAJIB diisi sendiri. Seed berhenti bila kosong atau kurang dari 12 karakter.
SEED_SUPER_ADMIN_EMAIL=admin@osis.local
SEED_SUPER_ADMIN_PASSWORD=GantiPassword123!
SEED_ORGANIZATION_NAME=OSIS SMKN 2 Mataram
