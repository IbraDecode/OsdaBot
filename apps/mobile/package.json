{
  "name": "@osda/mobile",
  "version": "2.0.0",
  "private": true,
  "description": "Aplikasi Mobile OSDA Platform (Expo / React Native). Mobile-first: quick action, absensi, tugas, acara, notifikasi, dan persetujuan.",
  "type": "module",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@osda/contracts": "workspace:*",
    "expo": "~54.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@osda/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "~19.1.0",
    "typescript": "catalog:"
  }
}
