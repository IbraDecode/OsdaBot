# ============================================================
# OSDA Bot — contoh konfigurasi environment
# Salin ke .env lalu isi dengan nilai asli:
#   cp .env.example .env
# JANGAN pernah commit berkas .env yang sudah terisi.
# ============================================================

# ---- Mode ---------------------------------------------------
NODE_ENV=development
# Zona waktu sekolah (dipakai untuk menentukan "hari ini")
TZ=Asia/Makassar

# ---- WhatsApp (Baileys) -------------------------------------
# false = bot tetap jalan tanpa koneksi WhatsApp (mode API saja).
WHATSAPP_ENABLED=false
# Nomor bot, format 62xxx (tanpa tanda +). Dipakai untuk pairing code.
WHATSAPP_PHONE_NUMBER=
# Direktori penyimpanan kredensial Baileys (SANGAT sensitif, jangan di-commit).
WHATSAPP_SESSION_DIR=./whatsapp-session
# Batas waktu QR/pairing sebelum socket meminta ulang (detik).
WHATSAPP_QR_TIMEOUT=60

# ---- OSDA API (sumber kebenaran untuk seluruh bisnis logic) -
# Base URL REST API OSDA, termasuk prefix versi.
API_URL=http://localhost:4000/api/v1
# Token layanan (service token) bot; dikirim sebagai Bearer token.
API_BOT_TOKEN=
# Timeout request & jumlah percobaan ulang (retry) ke API.
API_TIMEOUT_MS=10000
API_RETRY=2

# ---- Notifikasi realtime ------------------------------------
# true = bot polling endpoint notifikasi dan meneruskannya ke WhatsApp.
NOTIFIKASI_AKTIF=true
NOTIFIKASI_INTERVAL_MS=60000
# JID/nomu tujuan bila notifikasi tidak memiliki penerima spesifik
# (mis. 6281234567890 atau 12036xxxxx@g.us). Kosongkan bila tidak dipakai.
NOTIFIKASI_KIRIM_KE=

# ---- Logging -----------------------------------------------
LOG_LEVEL=info
