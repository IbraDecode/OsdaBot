{
  "name": "@osda/bot",
  "version": "2.0.0",
  "private": true,
  "description": "OSDA Bot \u2014 client WhatsApp ringan untuk OSDA Platform. Semua logika bisnis dijalankan lewat REST API OSDA, bukan akses langsung ke database.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@osda/contracts": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@osda/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pino": "^7.0.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
