{
  "name": "@osda/notifications",
  "version": "2.0.0",
  "private": true,
  "description": "Mesin notifikasi OSDA: pengirim in-app, WhatsApp, email, dan pendeteksi prioritas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./prioritas": {
      "types": "./dist/prioritas.d.ts",
      "import": "./dist/prioritas.js",
      "default": "./dist/prioritas.js"
    },
    "./penyedia": {
      "types": "./dist/penyedia.d.ts",
      "import": "./dist/penyedia.js",
      "default": "./dist/penyedia.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@osda/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@osda/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
