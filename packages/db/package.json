{
  "name": "@osda/db",
  "version": "2.0.0",
  "private": true,
  "description": "Skema database OSDA (Drizzle ORM) dan utilitas koneksi PostgreSQL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema": {
      "types": "./schema/index.d.ts",
      "import": "./schema/index.js",
      "default": "./schema/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js",
      "default": "./client.js"
    },
    "./tx": {
      "types": "./tx.d.ts",
      "import": "./tx.js",
      "default": "./tx.js"
    },
    "./sql": {
      "types": "./dist/sql/invariants.d.ts",
      "import": "./dist/sql/invariants.js",
      "default": "./dist/sql/invariants.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "push": "drizzle-kit push",
    "reset": "tsx src/cli/reset.ts",
    "seed": "tsx src/cli/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo drizzle"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@osda/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.2",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@osda/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.5",
    "argon2": "^0.44.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
