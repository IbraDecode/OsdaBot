{
  "name": "osdabot",
  "version": "2.0.0",
  "description": "OSDABOT — Platform AI Agent WhatsApp-native untuk membantu organisasi",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "osda": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env src/database/seed.ts",
    "lint": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "osda:pair": "tsx --env-file-if-exists=.env src/cli/pair.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bullmq": "5.58.5",
    "fastify": "5.6.1",
    "ioredis": "5.8.1",
    "openai": "6.9.0",
    "pino": "9.13.1",
    "qrcode-terminal": "0.12.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "22.19.1",
    "@types/qrcode-terminal": "0.12.2",
    "pino-pretty": "13.1.2",
    "prisma": "6.16.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env src/database/seed.ts"
  }
}
